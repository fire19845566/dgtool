---
import { ui } from '../i18n/ui';
import type { Lang } from '../i18n';
interface Props { items: { q: string; a: string }[]; lang: Lang }
const { items, lang } = Astro.props;
---
<section class="notes faq">
  <h2 class="faq-title">{ui[lang].content.faq}</h2>
  {items.map((i) => (<><h3>{i.q}</h3><p>{i.a}</p></>))}
</section>
