---
import type { CompressTool } from '../data/tools';
interface Props { tool: CompressTool }
const { tool } = Astro.props;
---
<div id="compressor">
  <label id="drop" for="file">
    <strong>Choose images or drop them here</strong>
    <span>JPG, PNG or WebP · you can select several at once</span>
  </label>
  <input id="file" type="file" accept={tool.accept} multiple />

  <div class="opts">
    <label for="q">Quality</label>
    <input id="q" type="range" min="40" max="95" value="80" />
    <span id="qv">80%</span>
  </div>
  <div class="opts selects">
    <label>Longest side
      <select id="size" class="sel">
        <option value="0">Original</option>
        <option value="3840">3840 px</option>
        <option value="2560">2560 px</option>
        <option value="1920">1920 px</option>
        <option value="1280">1280 px</option>
        <option value="1024">1024 px</option>
      </select>
    </label>
    <label>Format
      <select id="fmt" class="sel">
        <option value="same">Same as original</option>
        <option value="jpg">JPG</option>
        <option value="webp">WebP</option>
      </select>
    </label>
  </div>
  <p class="hint">PNG is compressed by reducing its colors, and Quality sets how many are kept. For photos, WebP or JPG gives much smaller files. JPG fills transparent areas with white.</p>

  <p id="summary" class="summary" hidden></p>
  <div class="bar" id="bar" hidden>
    <button class="btn" id="dlAll" type="button">Download all</button>
    <button class="btn ghost" id="clear" type="button">Clear list</button>
  </div>

  <ul id="list" aria-live="polite"></ul>
</div>

<script>
  import '../scripts/compressor-ui';
</script>
