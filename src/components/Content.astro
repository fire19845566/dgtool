---
import type { Tool } from '../data/tools';
import { ui } from '../i18n/ui';
import { fmt, type Lang } from '../i18n';
interface Props { tool: Tool; lang: Lang }
const { tool, lang } = Astro.props;
const t = ui[lang].content;
---
<section class="notes">
  <h2>{tool.kind === 'compress' ? t.howToCompress : tool.kind === 'resize' ? t.howToResize : tool.kind === 'watermark' ? t.howToWatermark : fmt(t.howToConvert, { name: tool.name })}</h2>
  <ol class="steps">
    {tool.howTo.map((s) => <li>{s}</li>)}
  </ol>
  {tool.sections.map((sec) => (
    <>
      <h2>{sec.h}</h2>
      {sec.p.map((p) => <p>{p}</p>)}
    </>
  ))}
</section>
