---
import type { WatermarkTool } from '../data/tools';
import { ui } from '../i18n/ui';
import type { Lang } from '../i18n';
interface Props { tool: WatermarkTool; lang: Lang }
const { tool, lang } = Astro.props;
const t = ui[lang];
const w = t.watermarker;
const strings = { ...t.common, ...w };
const positions = ['tl', 'tc', 'tr', 'ml', 'mc', 'mr', 'bl', 'bc', 'br'];
const arrows = ['↖', '↑', '↗', '←', '•', '→', '↙', '↓', '↘'];
---
<div id="watermarker" data-i18n={JSON.stringify(strings)}>
  <label id="drop" for="file">
    <strong>{w.dropTitle}</strong>
    <span>{w.dropSub}</span>
  </label>
  <input id="file" type="file" accept={tool.accept} multiple />

  <div id="previewWrap" hidden>
    <canvas id="preview" role="img" aria-label={w.previewAlt}></canvas>
  </div>

  <div class="opts selects">
    <label>{w.type}
      <select id="wtype" class="sel">
        <option value="text">{w.typeText}</option>
        <option value="image">{w.typeImage}</option>
      </select>
    </label>
    <label>{w.layout}
      <select id="layout" class="sel">
        <option value="single">{w.layoutSingle}</option>
        <option value="tile">{w.layoutTile}</option>
      </select>
    </label>
  </div>

  <div id="textBox" class="wbox">
    <label for="wtext">{w.text}</label>
    <textarea id="wtext" class="txt" rows="2" maxlength="200">{w.defaultText}</textarea>
    <div class="opts">
      <label for="fsize">{w.fontSize}</label>
      <input id="fsize" type="range" min="2" max="20" value="6" />
      <span id="fsizev">6%</span>
    </div>
    <div class="opts selects">
      <label>{w.color} <input id="wcolor" class="color" type="color" value="#ffffff" /></label>
      <label class="check"><input id="bold" type="checkbox" checked /> {w.bold}</label>
      <label class="check"><input id="outline" type="checkbox" checked /> {w.outline}</label>
    </div>
  </div>

  <div id="imageBox" class="wbox" hidden>
    <div class="opts selects">
      <label for="markFile" class="btn ghost">{w.chooseMark}</label>
      <input id="markFile" class="visually-hidden" type="file" accept=".png,.webp,.jpg,.jpeg,image/png,image/webp,image/jpeg" />
      <span id="markName" class="meta">{w.noMark}</span>
    </div>
    <div class="opts">
      <label for="iscale">{w.imageSize}</label>
      <input id="iscale" type="range" min="5" max="80" value="25" />
      <span id="iscalev">25%</span>
    </div>
  </div>

  <div class="opts">
    <label for="opacity">{w.opacity}</label>
    <input id="opacity" type="range" min="5" max="100" value="50" />
    <span id="opacityv">50%</span>
  </div>
  <div class="opts">
    <label for="rot">{w.rotation}</label>
    <input id="rot" type="range" min="-90" max="90" value="0" />
    <span id="rotv">0°</span>
  </div>

  <fieldset id="posBox" class="posbox">
    <legend>{w.position}</legend>
    <div class="posgrid">
      {positions.map((p, i) => (
        <label>
          <input type="radio" name="pos" value={p} checked={p === 'br'} aria-label={w.positions[i]} />
          <span aria-hidden="true">{arrows[i]}</span>
        </label>
      ))}
    </div>
  </fieldset>
  <div id="gapBox" class="opts" hidden>
    <label for="gap">{w.gap}</label>
    <input id="gap" type="range" min="20" max="300" value="100" />
    <span id="gapv">100%</span>
  </div>

  <div class="opts selects">
    <label>{w.format}
      <select id="fmt" class="sel">
        <option value="same">{w.formatSame}</option>
        <option value="jpg">JPG</option>
        <option value="png">PNG</option>
        <option value="webp">WebP</option>
      </select>
    </label>
    <label for="q">{w.quality}</label>
    <input id="q" type="range" min="40" max="100" value="90" />
    <span id="qv">90%</span>
  </div>

  <div class="bar" id="bar" hidden>
    <button class="btn" id="dlAll" type="button">{t.common.downloadAll}</button>
    <button class="btn ghost" id="clear" type="button">{t.common.clear}</button>
  </div>

  <ul id="list" aria-live="polite"></ul>
</div>

<script>
  import '../scripts/watermarker-ui';
</script>
