---
import Base from '../../layouts/Base.astro';
import ToolCard from '../../components/ToolCard.astro';
import { tools, categories } from '../../data/tools';

export function getStaticPaths() {
  return Object.keys(categories).map((category) => ({ params: { category } }));
}
const { category } = Astro.params;
const cat = categories[category as keyof typeof categories];
const list = tools.filter((t) => t.category === category);
---
<Base title={`Free ${cat.label} Tools – Private, No Upload | DGTool`} description={cat.blurb}>
  <p class="crumb"><a href="/">Home</a> / {cat.label} tools</p>
  <h1>{cat.label} tools</h1>
  <p class="lead">{cat.blurb}</p>
  <div class="cards">
    {list.map((t) => <ToolCard tool={t} />)}
  </div>
</Base>
