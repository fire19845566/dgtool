---
import '../styles/global.css';
import { ui } from '../i18n/ui';
import { LANGS, LANG_META, DEFAULT_LANG, localePath, switchPath, type Lang } from '../i18n';
import { getTools, toolPath, categoryKeys } from '../data/tools';
interface Props { lang: Lang; title: string; description: string; jsonLd?: object }
const { lang, title, description, jsonLd } = Astro.props;
const t = ui[lang];
const meta = LANG_META[lang];
const pathname = Astro.url.pathname;
const canonical = new URL(pathname, Astro.site);
const ogImage = new URL('/og-image.png', Astro.site);
// Pages to keep for offline use (see src/scripts/pwa.ts)
const offlineUrls = [
  localePath(lang, '/'),
  ...categoryKeys.map((k) => localePath(lang, `/${k}`)),
  ...getTools(lang).map((tool) => toolPath(tool, lang)),
  localePath(lang, '/about'),
  localePath(lang, '/privacy'),
  localePath(lang, '/terms'),
];
const alternates = LANGS.map((l) => ({ l, href: new URL(switchPath(pathname, lang, l), Astro.site) }));
---
<!doctype html>
<html lang={meta.html}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={LANG_META[a.l].html} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={alternates.find((a) => a.l === DEFAULT_LANG)!.href} />
    <link rel="manifest" href={localePath(lang, '/manifest.json')} />
    <meta name="apple-mobile-web-app-title" content={t.site.name} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#F5F8FC" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#09111F" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={meta.og} />
    {LANGS.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={LANG_META[l].og} />)}
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Quicksand:wght@600;700&display=swap" rel="stylesheet" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <header class="site">
      <a class="logo" href={localePath(lang, '/')} aria-label={t.site.homeAria}>
        <picture>
          <source srcset="/logo-dark.svg" media="(prefers-color-scheme: dark)" />
          <img src="/logo-light.svg" width="186" height="38" alt={t.site.logoAlt} />
        </picture>
      </a>
      <nav class="langs" aria-label={t.site.language}>
        {alternates.map((a) => (
          <a href={a.href.pathname} lang={LANG_META[a.l].html} hreflang={LANG_META[a.l].html} aria-current={a.l === lang ? 'true' : undefined}>{LANG_META[a.l].label}</a>
        ))}
      </nav>
    </header>
    <main><slot /></main>
    <footer class="site" id="pwa" data-config={JSON.stringify({ urls: offlineUrls })}>
      <a href={localePath(lang, '/about')}>{t.site.about}</a> · <a href={localePath(lang, '/privacy')}>{t.site.privacy}</a> · <a href={localePath(lang, '/terms')}>{t.site.terms}</a>
      <button id="install" class="linklike" type="button" hidden>{t.install.button}</button>
      <dialog id="iosHelp">
        <p>{t.install.iosHelp}</p>
        <form method="dialog"><button class="btn ghost" type="submit">{t.install.close}</button></form>
      </dialog>
    </footer>
    <script>
      import '../scripts/pwa';
    </script>
  </body>
</html>
